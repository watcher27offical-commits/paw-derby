{
  "name": "paw-derby-ios",
  "version": "1.0.0",
  "private": true,
  "description": "iOS app shell for Paw Derby (loads the live game from Fly.io).",
  "scripts": {
    "ios:add": "cap add ios",
    "ios:assets": "capacitor-assets generate --ios --iconBackgroundColor \"#241848\" --splashBackgroundColor \"#241848\" --splashBackgroundColorDark \"#241848\"",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@capacitor/assets": "^3.0.5"
  }
}
